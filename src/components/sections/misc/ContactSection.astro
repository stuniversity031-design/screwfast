---
// Import the necessary dependencies.
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';

// Define the variables that will be used in this component
const title: string = 'Book a Free Strategy Call';
const subTitle: string =
  "Ready to grow your business? Tell us what you need and we'll respond within minutes — day or night.";
const formTitle: string = 'Fill in the form below';
const formSubTitle: string = "We respond within minutes — day or night.";
---

{/* Contact Us */}
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        {title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {formTitle}
        </h2>

        <form action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="76f64f26-50b3-4adc-bf80-11555cd6ea65" />
          <input type="hidden" name="subject" value="New Consultation Request — Crestivo" />
          <input type="hidden" name="redirect" value="https://screwfast-ten-rho.vercel.app/contact" />

          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="hs-firstname-contacts"
                label="First Name"
                name="name"
              />
              <TextInput
                id="hs-lastname-contacts"
                label="Last Name"
                name="lastname"
              />
            </div>
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />
            <TextAreaInput
              id="hs-about-contacts"
              label="Tell us about your project or idea"
              name="message"
            />
          </div>

          <div class="mt-4 grid">
            <AuthBtn title="Book My Free Strategy Call" />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {formSubTitle}
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading="FAQ"
          content="Explore our FAQ for quick, clear answers to common questions about our services."
          isLinkVisible={true}
          linkTitle="Visit FAQ"
          linkURL="/#faq"
          isArrowVisible={true}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading="Visit Our Office"
          content="Crestivo Agency — New York"
          isAddressVisible={true}
          addressContent="154 W 14th St, New York, NY 10011"
          ><Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading="Email Us Directly"
          content="Prefer to send a message? Reach us at"
          isLinkVisible={true}
          linkTitle="Propertiesonlinellc@outlook.com"
          linkURL="mailto:Propertiesonlinellc@outlook.com"
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>

        <ContactIconBlock
          heading="Pricing & Packages"
          content="See our current limited time offers and package deals."
          isLinkVisible={true}
          linkTitle="View Pricing"
          linkURL="/#pricing"
          isArrowVisible={true}
          ><Icon name="question" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
