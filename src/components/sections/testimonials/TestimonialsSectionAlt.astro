---
import AvatarTestimonialSection from '../../ui/avatars/AvatarTestimonialSection.astro';

const { title, testimonials } = Astro.props;

interface Testimonial {
  content: string;
  author: string;
  role: string;
  avatarSrc: string;
  avatarAlt: string;
}

interface Props {
  title: string;
  testimonials: Testimonial[];
}
---

<section
  class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 2xl:max-w-full"
  id="testimonials"
>
  <div class="mb-16 text-center">
    <h2 class="text-4xl font-extrabold text-neutral-900 dark:text-white">
      {title}
    </h2>
  </div>

  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
    {testimonials.map((testimonial) => (
      <div class="flex">
        <div class="flex flex-col rounded-2xl border border-neutral-200 bg-white shadow-lg dark:border-neutral-700 dark:bg-neutral-800">
          <div class="flex-auto p-8">
            <p class="text-lg italic leading-relaxed text-neutral-700 dark:text-neutral-300">
              “{testimonial.content}”
            </p>

            <div class="mt-4 text-sm tracking-widest text-yellow-400">
              ★★★★★
            </div>
          </div>

          <div class="rounded-b-2xl bg-neutral-100 p-6 dark:bg-neutral-900">
            <div class="flex items-center">
              <AvatarTestimonialSection
                src={testimonial.avatarSrc}
                alt={testimonial.avatarAlt}
              />

              <div class="ms-4">
                <p class="text-base font-bold text-neutral-900 dark:text-white">
                  {testimonial.author}
                </p>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  {testimonial.role}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>