---
import { Image } from 'astro:assets';
import Icon from '../../ui/icons/Icon.astro';

const { content, author, role, avatarSrc } = Astro.props;

interface Props {
  content: string;
  author: string;
  role: string;
  avatarSrc: string;
}
---

<blockquote class="relative rounded-2xl border border-neutral-200 bg-white p-8 shadow-xl transition-all duration-300 hover:shadow-2xl dark:border-neutral-700 dark:bg-neutral-800">
  <!-- Quotation Icon -->
  <div class="absolute -top-4 -left-4 opacity-10">
    <Icon name="quotation" />
  </div>

  <!-- Testimonial Text -->
  <div class="relative z-10">
    <p class="text-2xl font-semibold leading-relaxed italic text-neutral-800 dark:text-neutral-200">
      “{content}”
    </p>

    <!-- 5 Star Rating -->
    <div class="mt-4 text-sm tracking-widest text-yellow-400">
      ★★★★★
    </div>
  </div>

  <!-- Author Section -->
  <div class="mt-8 flex items-center">
    <div class="shrink-0">
      <Image
        class="h-12 w-12 rounded-full object-cover ring-2 ring-neutral-300 dark:ring-neutral-600"
        src={avatarSrc}
        alt={`${author} avatar`}
        loading="eager"
        inferSize
      />
    </div>

    <div class="ms-4">
      <div class="text-base font-bold text-neutral-900 dark:text-white">
        {author}
      </div>
      <div class="text-sm text-neutral-500 dark:text-neutral-400">
        {role}
      </div>
    </div>
  </div>
</blockquote>