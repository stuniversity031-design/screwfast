---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.avif';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import pricing from '@data/pricing.json';
import featureImage from '@images/features-image.avif';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';

const avatarSrcs: Array<string> = [
  'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
];
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Price Match Guarantee — We'll Beat Any Quote. No Exceptions."
    url="/contact"
  />

  <HeroSection
    title=`The Marketing & <span
        class="text-yellow-500 dark:text-yellow-400">Tech Company</span>`
    subTitle="We use modern technology systems to tailor to any business, entrepreneur, or everyday person — websites, animations, QR tech, digital content, business blueprints, business cards, logos, and flyers. Use our ROI calculator and let our professional business consultants design a marketing strategy for you."
    primaryBtn="Get Started"
    primaryBtnURL="/contact"
    secondaryBtn="See Our Work"
    secondaryBtnURL="/work"
    withReview={true}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.9</span> / 5`
    starCount={5}
    reviews=`From Over <span class="font-bold">200+</span> Happy Clients`
    src={heroImage}
    alt="Crestivo marketing and technology agency hero image"
  />

  <ClientsSection
    title="Trusted by Businesses & Entrepreneurs"
    subTitle="Modern tools. Real results. Built for brands of every size."
    partners={partnersData}
  />

  <FeaturesGeneral
    title="Built for Businesses & Everyday People"
    subTitle="Crestivo is a marketing and technology agency that can do it all — from creating small ads to ultra-professional videos and commercials for any brand, person, or product. We don't just design — we engineer. Our systems are built to do all the work for you, from QR codes to full websites, animations, videos, digital content, YouTube pages, and podcast creation. Everything we create will produce significant results."
    src={featureImage}
    alt="Crestivo marketing systems and digital tools"
    features={features}
  />

  <FeaturesNavs
    title=`Everything Your Business Needs — <span class="text-yellow-500 dark:text-yellow-400">All In One Place</span>`
    tabs={[
      {
        heading: 'Web & Funnel Systems',
        content:
          'High-converting websites, landing pages, and marketing ads built to increase your sales performance. Includes cartoon and character creation for your brand.',
        svg: 'tools',
        src: tools,
        alt: 'Web and funnel systems built by Crestivo',
        first: true,
      },
      {
        heading: 'QR Code Platforms',
        content:
          'Dynamic QR systems for marketing, events, products, and customer engagement. Real estate agents use our QR vCards to list and show properties. Restaurants use them for menus and promos.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'QR code platform built by Crestivo',
        second: true,
      },
      {
        heading: 'Content & Digital Media',
        content:
          'Videos, animations, branded visuals, podcasts, and marketing assets that capture attention and drive results. Launch a full digital animation in as little as one day.',
        svg: 'house',
        src: construction,
        alt: 'Content and digital media created by Crestivo',
      },
    ]}
  />

  <TestimonialsSection
    title="What Clients Say About Crestivo"
    subTitle="We build systems that work — and our clients feel the difference from day one."
    testimonials={[
      {
        content:
          "Crestivo didn't just build us a website — they built the engine behind our business. Professional, fast, and results-driven from start to finish.",
        author: 'Marcus T.',
        role: 'Founder | MT Brands',
        avatarSrc:
          'https://images.unsplash.com/photo-1593104547489-5cfb3839a3b5?q=80&w=1453&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
      },
    ]}
    statistics={[
      {
        count: '200+',
        description: 'businesses and everyday people served across all industries',
      },
      {
        count: '100%',
        description: 'price match guarantee — we beat any quote, no exceptions',
      },
      {
        count: '1 Day',
        description: 'turnaround on select digital animations and content assets',
      },
      {
        count: '5★',
        description: 'average client rating across all projects and services',
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <FAQ title="Questions<br />People Ask" faqs={faqs} />

  <HeroSectionAlt
    title="You Don't Need Another Website. You Need a System That Works for You."
    subTitle="Let's turn your idea into a real case scenario so you can start attracting customers immediately. Book your free strategy call today."
    url="/contact"
  />
</MainLayout>
